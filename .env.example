# MongoDB Atlas connection string (Atlas > Connect > Drivers > copy, add the db name)
MONGODB_URI="mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/college_portal?retryWrites=true&w=majority"
MONGODB_DB="college_portal"

# Long random string used to sign login sessions
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="change-me-to-a-long-random-string"

# Optional: allows re-seeding a database that already contains data
SEED_TOKEN="change-me-too"
